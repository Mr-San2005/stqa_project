{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:unit": "jest tests/authController.test.js tests/authUtils.test.js tests/resultUtils.test.js --verbose",
    "test:blackbox": "jest tests/blackbox.test.js --verbose --testTimeout=30000",
    "test:coverage": "jest tests/resultUtils.test.js --coverage --verbose",
    "test:integration": "jest tests/integration.test.js --verbose --testTimeout=30000",
    "test:age": "jest tests/ageField.test.js --verbose --testTimeout=30000",
    "test:selenium": "node tests/selenium/login.test.js",
    "test:all": "jest --verbose --testTimeout=30000 --testPathIgnorePatterns=selenium",
    "test:ci": "node -e \"require('fs').mkdirSync('test-results', { recursive: true })\" && jest --ci --maxWorkers=2 --verbose --testTimeout=30000 --testPathIgnorePatterns=selenium --json --outputFile=test-results/jest-report.json",
    "seed:demo": "node src/scripts/seedDemoData.js",
    "clean:test-data": "node src/scripts/cleanBvaTestData.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0",
    "selenium-webdriver": "^4.27.0",
    "chromedriver": "^136.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "forceExit": true,
    "detectOpenHandles": true,
    "setupFiles": ["<rootDir>/tests/setup.js"]
  }
}
